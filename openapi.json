{
  "openapi": "3.1.0",
  "info": {
    "title": "Payment Basic",
    "version": "0.1.0",
    "description": "Local learning API. Merchant header is a demo identifier, not authentication. Results are current state, not cached HTTP responses."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "paths": {
    "/payments": {
      "post": {
        "operationId": "createPayment",
        "parameters": [
          {
            "name": "X-Merchant-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePayment"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current state of an existing operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "201": {
            "description": "New operation reached a terminal state; inspect status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "202": {
            "description": "Operation is pending or unknown",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "Suggested polling delay in seconds"
              },
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Payment resource path"
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Key reused with different amount or currency",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Provider capacity reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Storage or internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/payments/{id}": {
      "get": {
        "operationId": "getPayment",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Merchant-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current payment state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "404": {
            "description": "Missing or different merchant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/reconcile": {
      "post": {
        "operationId": "reconcile",
        "security": [
          {
            "LocalAdmin": []
          }
        ],
        "responses": {
          "200": {
            "description": "Processed a batch of at most 100 unresolved payments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "checked",
                    "pending"
                  ],
                  "properties": {
                    "checked": {
                      "type": "integer"
                    },
                    "pending": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Invalid admin token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Batch already active",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Storage or internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/breaks": {
      "get": {
        "operationId": "getBreaks",
        "security": [
          {
            "LocalAdmin": []
          }
        ],
        "responses": {
          "200": {
            "description": "Durable recovery discrepancies",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Break"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Invalid admin token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Process is serving requests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "operationId": "metrics",
        "responses": {
          "200": {
            "description": "Prometheus text exposition",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreatePayment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000,
            "description": "Minor currency units; use an integer JSON literal."
          },
          "currency": {
            "type": "string",
            "enum": [
              "JPY",
              "USD"
            ]
          }
        }
      },
      "Payment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "amount",
          "currency",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "integer"
          },
          "currency": {
            "type": "string",
            "enum": [
              "JPY",
              "USD"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "UNKNOWN",
              "SUCCEEDED",
              "DECLINED"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Break": {
        "type": "object",
        "required": [
          "payment_id",
          "reason",
          "resolved",
          "updated_at"
        ],
        "properties": {
          "payment_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "resolved": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "updated_at": {
            "type": "integer"
          }
        }
      }
    },
    "securitySchemes": {
      "LocalAdmin": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Admin-Token",
        "description": "Local demo token; default local-admin"
      }
    }
  }
}
